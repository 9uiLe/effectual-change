+
+test.each([
+  ["header", headerLine, "partial", 0],
+  ["empty partial", `${headerLine}${trailerLine("partial", 0, null)}`, "partial", 0],
+  ["running", prefix, "partial", 1],
+  ["fragment", `${prefix}{SECRET_UNACCEPTED`, "partial", 1],
+  ["no final LF", `${prefix}${finish}`, "partial", 1],
+  ["finished without trailer", terminal, "partial", 2],
+  ["partial terminal", `${terminal}${trailerLine("partial", 2, 1)}`, "partial", 2],
+  ["complete", complete, "complete", 2],
+  ["trailer fragment", `${terminal}${trailerLine("complete", 2, 1).trimEnd()}`, "partial", 2],
+  ["trailing bytes", `${complete}SECRET_UNACCEPTED`, "invalid", 2],
