+  ],
+  [
+    "trailer field",
+    trailerLine("partial", 1, 0).replace('"lastSeq":0', '"lastSeq":0,"secret":"SECRET_UNACCEPTED"'),
+  ],
+  ["unfinished complete", trailerLine("complete", 1, 0)],
+  ["oversized frame", `${"x".repeat(70_000)}\n`],
