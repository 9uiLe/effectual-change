+      if (!temporary) throw new Error("Expected a private temporary recording.");
+      expect(await readFile(join(dir, temporary), "utf8")).toBe(complete);
+      await writeFile(output, "LATE COMPETITOR", { flag: "wx" });
+      await original.call(this);
+    });
+    try {
+      await expect(
+        recoverRecording(input, output, new AbortController().signal),
+      ).rejects.toMatchObject({ code: "INVALID_ARGUMENT", exit: 2 });
+      expect(descriptor?.fd).toBe(-1);
+      expect(await readFile(output, "utf8")).toBe("LATE COMPETITOR");
+      expect((await readdir(dir)).sort()).toEqual(["input.ndjson", "output.ndjson"]);
+    } finally {
