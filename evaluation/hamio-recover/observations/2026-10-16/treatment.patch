+  ["runId", `${finish.replace('"runId":"r"', '"runId":"other"')}\n`],
+  ["transition", `${frame(1, "task.started", { taskId: "missing" })}\n`],
+  ["CRLF", `${finish}\r\n`],
+  ["blank", "\n"],
