new file mode 100644
index 0000000..8068069
--- /dev/null
+++ b/src/recording/recover.ts
@@ -0,0 +1,80 @@
+import { randomUUID } from "node:crypto";
+import { link, open, unlink, type FileHandle } from "node:fs/promises";
+import { basename, dirname, join } from "node:path";
+import { encodeEvent } from "../protocol/encode.ts";
+import { protocolLimits } from "../protocol/limits.ts";
+import { headerLine, recordingLimits, trailerLine } from "./format.ts";
+import { readRecording, type RecordedReplay } from "./reader.ts";
+import { RecordingWriteError } from "./writer.ts";
+
+export class RecordingRecoveryError extends Error {
+  constructor(
+    readonly code: string,
+    readonly exit: number,
+    message: string,
+  ) {
+    super(message);
+  }
+}
+
+/** Preserve accepted events, not a reconstruction from the final State. */
+export async function recoverRecording(
+  input: string,
+  output: string,
+  signal: AbortSignal,
+): Promise<{ source: RecordedReplay; status: "complete" | "partial" }> {
+  const temporary = join(dirname(output), `.${basename(output)}.${randomUUID()}.tmp`);
+  let file: FileHandle | undefined;
+  let owned = false;
+  let bytes = 0;
+  const write = async (line: string): Promise<void> => {
+    signal.throwIfAborted();
+    if (!file) throw new Error("Recording header has not been accepted.");
+    const size = Buffer.byteLength(line);
+    if (size - 1 > protocolLimits.frameBytes || bytes + size > recordingLimits.bytes)
+      throw new RecordingWriteError("LIMIT_EXCEEDED");
+    await file.writeFile(line, { encoding: "utf8", signal });
+    bytes += size;
+  };
+  try {
+    try {
+      signal.throwIfAborted();
+      const source = await readRecording(input, signal, {
+        async header() {
+          file = await open(temporary, "wx", 0o600);
+          owned = true;
+          await write(headerLine);
+        },
+        async event(event) {
+          await write(`${encodeEvent(event)}\n`);
+        },
+      });
+      if (!file) {
+        if (source.kind === "invalid")
+          throw new RecordingRecoveryError(source.issue.code, 2, source.issue.message);
+        throw new Error("Recording header is missing.");
+      }
+      const status = source.kind === "complete" ? "complete" : "partial";
+      await write(trailerLine(status, source.eventCount, source.lastSeq));
+      await file.sync();
+      await file.close();
+      file = undefined;
+      signal.throwIfAborted();
+      await link(temporary, output);
+      return { source, status };
+    } finally {
+      try {
+        await file?.close();
+      } finally {
+        if (owned) await unlink(temporary);
+      }
+    }
+  } catch (error) {
+    if (signal.aborted) throw signal.reason;
+    if (error instanceof RecordingRecoveryError || error instanceof RecordingWriteError)
+      throw error;
+    if (error instanceof Error && "code" in error && error.code === "EEXIST")
+      throw new RecordingRecoveryError("INVALID_ARGUMENT", 2, "Recording file already exists.");
+    throw new RecordingRecoveryError("IO_ERROR", 7, "Could not recover Recording file.");
+  }
+}
