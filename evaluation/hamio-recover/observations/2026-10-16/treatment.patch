+import { productCommand } from "./support/command.ts";
+
+const frame = (seq: number, type: string, fields: Record<string, unknown> = {}) =>
+  JSON.stringify({ protocolVersion: 2, runId: "r", seq, type, ...fields });
+const start = frame(0, "run.started", { title: "Recover me" });
+const finish = frame(1, "run.finished", { result: { kind: "succeeded", data: { kind: "none" } } });
+const prefix = `${headerLine}${start}\n`;
+const terminal = `${prefix}${finish}\n`;
+const complete = `${terminal}${trailerLine("complete", 2, 1)}`;
+
+async function fixture(check: (dir: string, input: string, output: string) => Promise<void>) {
+  const dir = await mkdtemp(join(tmpdir(), "hamio-recover-"));
+  try {
+    await check(dir, join(dir, "input.ndjson"), join(dir, "output.ndjson"));
+  } finally {
+    await chmod(dir, 0o700);
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+function spawn(args: string[]) {
+  return Bun.spawn(productCommand(["presentation", ...args]), {
+    stdin: "ignore",
+    stdout: "pipe",
+    stderr: "pipe",
+    timeout: 15000,
+  });
+}
+
+async function result(child: ReturnType<typeof spawn>) {
+  const [code, stdout, stderr] = await Promise.all([
+    child.exited,
+    new Response(child.stdout).text(),
+    new Response(child.stderr).text(),
+  ]);
+  expect(stdout.trim().split("\n")).toHaveLength(1);
+  expect(stderr).toBe("");
+  return { code, response: JSON.parse(stdout), stdout };
+}
+
+async function cli(input: string, output: string) {
+  return result(spawn(["recover", "--input", input, "--output", output]));
+}
+
