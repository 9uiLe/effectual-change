+async function longRecording(input: string) {
+  const file = await open(input, "w");
+  try {
+    await file.writeFile(
+      `${prefix}${frame(1, "task.declared", { taskId: "t", label: "Task", placement: { kind: "root" } })}\n${frame(2, "task.started", { taskId: "t" })}\n`,
+    );
+    for (let seq = 3; seq < 20003; seq++) {
+      await file.writeFile(
+        `${frame(seq, "task.progressed", { taskId: "t", progress: { kind: "indeterminate" } })}\n`,
+      );
+    }
+  } finally {
+    await file.close();
+  }
+}
