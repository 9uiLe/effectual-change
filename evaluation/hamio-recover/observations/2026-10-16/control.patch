+import { RecordingWriter } from "../src/recording/writer.ts";
+
+const start = '{"protocolVersion":2,"runId":"r","seq":0,"type":"run.started","title":"Run"}';
+const finish =
+  '{"protocolVersion":2,"runId":"r","seq":1,"type":"run.finished","result":{"kind":"succeeded","data":{"kind":"none"}}}';
+const complete = `${headerLine}${start}\n${finish}\n${trailerLine("complete", 2, 1)}`;
+
+async function fixture(check: (input: string, output: string, dir: string) => Promise<void>) {
+  const dir = await mkdtemp(join(tmpdir(), "hamio-recover-io-"));
+  const input = join(dir, "input");
+  try {
+    await writeFile(input, complete);
+    await check(input, join(dir, "output"), dir);
+  } finally {
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+async function execute(input: string, output: string, signal = new AbortController().signal) {
+  const machine: string[] = [];
+  const human: string[] = [];
+  const code = await executePresentation(["recover", "--input", input, "--output", output], {
+    stdin: Readable.from([]),
+    signal,
+    env: {},
+    stdout: new Writable({
+      write(chunk, _encoding, callback) {
+        machine.push(String(chunk));
+        callback();
+      },
+    }),
+    stderr: new Writable({
+      write(chunk, _encoding, callback) {
+        human.push(String(chunk));
+        callback();
+      },
+    }),
+  });
+  expect(human).toEqual([]);
+  expect(machine).toHaveLength(1);
+  expect(machine.join("")).not.toContain("private-fault-marker");
+  return { code, response: JSON.parse(machine.join("")) };
+}
+
+test.each(["header write", "event write", "zero write", "sync", "close"] as const)(
+  "recovery cleans file and descriptor after %s failure",
+  async (stage) => {
+    await fixture(async (input, output, dir) => {
+      const initialize = RecordingWriter.fromFile;
+      let handle: FileHandle | undefined;
+      const hook = spyOn(RecordingWriter, "fromFile").mockImplementationOnce(
+        async (file, signal) => {
+          handle = file;
+          if (stage === "header write")
+            spyOn(file, "write").mockRejectedValueOnce(new Error("private-fault-marker"));
+          const writer = await initialize(file, signal);
+          if (stage === "event write")
+            spyOn(file, "write").mockRejectedValueOnce(new Error("private-fault-marker"));
+          if (stage === "zero write")
+            spyOn(file, "write").mockResolvedValueOnce({ bytesWritten: 0, buffer: "" });
+          if (stage === "sync")
+            spyOn(file, "sync").mockRejectedValueOnce(new Error("private-fault-marker"));
+          if (stage === "close")
+            spyOn(file, "close").mockRejectedValueOnce(new Error("private-fault-marker"));
+          return writer;
+        },
+      );
+      try {
+        const result = await execute(input, output);
+        expect(result.code).toBe(7);
+        expect(result.response).toMatchObject({
+          protocolVersion: 2,
+          status: "error",
+          error: { code: "IO_ERROR" },
+        });
+        expect(handle?.fd).toBe(-1);
+        expect(await readdir(dir)).toEqual(["input"]);
+        expect(await readFile(input, "utf8")).toBe(complete);
+      } finally {
+        hook.mockRestore();
+      }
+    });
+  },
+);
+
+test("publication is exclusive even when a competitor creates the final path during sync", async () => {
+  await fixture(async (input, output, dir) => {
+    const initialize = RecordingWriter.fromFile;
+    let handle: FileHandle | undefined;
+    const hook = spyOn(RecordingWriter, "fromFile").mockImplementationOnce(async (file, signal) => {
+      handle = file;
+      const writer = await initialize(file, signal);
+      const sync = file.sync.bind(file);
+      spyOn(file, "sync").mockImplementationOnce(async () => {
+        expect(await Bun.file(output).exists()).toBe(false);
+        await sync();
+        await writeFile(output, "competitor", { flag: "wx" });
+      });
+      return writer;
+    });
+    try {
+      const result = await execute(input, output);
+      expect(result.code).toBe(2);
+      expect(result.response.error.code).toBe("INVALID_ARGUMENT");
+      expect(await readFile(output, "utf8")).toBe("competitor");
+      expect(handle?.fd).toBe(-1);
+      expect((await readdir(dir)).sort()).toEqual(["input", "output"]);
+    } finally {
+      hook.mockRestore();
+    }
+  });
+});
+
+test.each(["before start", "after event", "during sync", "after close"] as const)(
+  "recovery interrupted %s never publishes",
+  async (stage) => {
+    await fixture(async (input, output, dir) => {
+      const controller = new AbortController();
+      const initialize = RecordingWriter.fromFile;
+      let handle: FileHandle | undefined;
+      const hook = spyOn(RecordingWriter, "fromFile").mockImplementationOnce(
+        async (file, signal) => {
+          handle = file;
+          expect(signal).toBe(controller.signal);
+          const writer = await initialize(file, signal);
+          if (stage === "after event") {
+            const append = writer.append.bind(writer);
+            spyOn(writer, "append").mockImplementationOnce(async (event) => {
+              await append(event);
+              controller.abort(new Cancelled());
+            });
+          }
+          if (stage === "during sync") {
+            const sync = file.sync.bind(file);
+            spyOn(file, "sync").mockImplementationOnce(async () => {
+              await sync();
+              controller.abort(new Cancelled());
+            });
+          }
+          if (stage === "after close") {
+            const close = file.close.bind(file);
+            spyOn(file, "close").mockImplementationOnce(async () => {
+              await close();
+              controller.abort(new Cancelled());
+            });
+          }
+          return writer;
+        },
+      );
+      try {
+        if (stage === "before start") controller.abort(new Cancelled());
+        const result = await execute(input, output, controller.signal);
+        expect(result.code).toBe(130);
+        expect(result.response).toMatchObject({
+          protocolVersion: 2,
+          status: "error",
+          error: { code: "INTERRUPTED" },
+        });
+        if (stage !== "before start") expect(handle?.fd).toBe(-1);
+        expect(await readdir(dir)).toEqual(["input"]);
+      } finally {
+        hook.mockRestore();
+      }
+    });
+  },
+);
+
+test("reader sink awaits accepted events, leaves replay unchanged, and propagates destination errors", async () => {
+  await fixture(async (input) => {
+    const baseline = await readRecording(input);
+    const seen: number[] = [];
+    let started = false;
+    const replay = await readRecording(input, undefined, {
+      async start() {
+        await Bun.sleep(1);
+        started = true;
+      },
+      async append(event) {
+        expect(started).toBe(true);
+        await Bun.sleep(1);
+        seen.push(event.seq);
+      },
+    });
+    expect(replay).toEqual(baseline);
+    expect(seen).toEqual([0, 1]);
+    const failure = new Error("destination stopped");
+    await expect(
+      readRecording(input, undefined, {
+        async start() {},
+        async append() {
+          throw failure;
+        },
+      }),
+    ).rejects.toBe(failure);
+  });
+});
+
+test("canonical recovery does not retain source JSON spelling or synthesize events", async () => {
+  await fixture(async (input, output) => {
+    await writeFile(
+      input,
+      `${headerLine}{ "title":"R\\u0075n", "type":"run.started", "seq":0, "runId":"r", "protocolVersion":2 }\n${finish}\n`,
+    );
+    const result = await execute(input, output);
+    expect(result.code).toBe(0);
+    expect(result.response).toMatchObject({
+      runState: "succeeded",
+      recording: { status: "partial", eventCount: 2 },
+    });
+    expect(await readFile(output, "utf8")).toBe(
+      `${headerLine}${start}\n${finish}\n${trailerLine("partial", 2, 1)}`,
+    );
+  });
+});
