+  const directory = await mkdtemp(join(tmpdir(), "hamio-recover-native-"));
+  try {
+    const input = join(directory, "input.ndjson");
+    const output = join(directory, "output.ndjson");
+    const accepted = `${headerLine}${[
+      { protocolVersion: 2, runId: "native", seq: 0, type: "run.started", title: "Native" },
+      {
+        protocolVersion: 2,
+        runId: "native",
+        seq: 1,
+        type: "run.finished",
+        result: { kind: "succeeded", data: { kind: "none" } },
+      },
+    ]
+      .map((event) => JSON.stringify(event))
+      .join("\n")}\n`;
