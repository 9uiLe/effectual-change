+  await fixture(body, async (input, output, dir) => {
+    const original = await readFile(input);
+    const result = await recover(input, output);
+    expect(result.code).toBe(0);
+    const metadata = {
+      recordingVersion: 1,
+      status,
+      eventCount: count,
+      lastRecordedSeq: count === 0 ? null : count - 1,
+    };
+    expect(result.response).toEqual({
+      protocolVersion: 2,
+      status: "ok",
+      runId: count === 0 ? null : "recovered",
+      runState,
+      sourceRecording: metadata,
+      recording: metadata,
+    });
+    expect(await readFile(input)).toEqual(original);
+    expect((await stat(output)).mode & 0o777).toBe(0o600);
+    expect((await readdir(dir)).sort()).toEqual(["rescued.ndjson", "source.ndjson"]);
+    const events = count === 0 ? "" : count === 1 ? `${start}\n` : `${start}\n${finish}\n`;
+    expect(await readFile(output, "utf8")).toBe(
+      `${headerLine}${events}${trailerLine(status, count, count === 0 ? null : count - 1)}`,
+    );
+    const source = await readRecording(input);
+    const rescued = await readRecording(output);
+    expect(rescued.kind).toBe(status);
+    expect(rescued).toMatchObject({
+      state: source.kind === "invalid" ? source.acceptedPrefix : source.state,
+    });
+  });
+});
+
+test.each([
+  ["JSON", `${prefix}{"${rejected}":\n${finish}\n`, 3, "INVALID_JSON", 1],
