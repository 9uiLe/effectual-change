+import { headerLine, recordingLimits, trailerLine } from "../src/recording/format.ts";
+import { readRecording } from "../src/recording/reader.ts";
+import { productCommand } from "./support/command.ts";
+
+const frame = (seq: number, type: string, fields: Record<string, unknown> = {}) =>
+  JSON.stringify({ protocolVersion: 2, runId: "recovered", seq, type, ...fields });
+const start = frame(0, "run.started", { title: "Build 日本語" });
+const finish = frame(1, "run.finished", { result: { kind: "succeeded", data: { kind: "none" } } });
+const prefix = `${headerLine}${start}\n`;
+const finished = `${prefix}${finish}\n`;
+const complete = `${finished}${trailerLine("complete", 2, 1)}`;
+const rejected = "unaccepted-private-marker";
+
+async function cli(args: string[]) {
+  const child = Bun.spawn(productCommand(args), {
+    stdin: "ignore",
+    stdout: "pipe",
+    stderr: "pipe",
+    timeout: 5000,
+  });
+  const [code, stdout, stderr] = await Promise.all([
+    child.exited,
+    new Response(child.stdout).text(),
+    new Response(child.stderr).text(),
+  ]);
+  return { code, stdout, stderr };
+}
+
+async function fixture(
+  body: string | Uint8Array,
+  check: (input: string, output: string, dir: string) => Promise<void>,
+) {
+  const dir = await mkdtemp(join(tmpdir(), "hamio-recover-cli-"));
+  const input = join(dir, "source.ndjson");
+  const output = join(dir, "rescued.ndjson");
+  try {
+    await writeFile(input, body);
+    await check(input, output, dir);
+  } finally {
+    await chmod(dir, 0o700);
+    await rm(dir, { recursive: true, force: true });
+  }
+}
+
+async function recover(input: string, output: string) {
+  const result = await cli(["presentation", "recover", "--input", input, "--output", output]);
+  expect(result.stderr).toBe("");
+  expect(result.stdout.trim().split("\n")).toHaveLength(1);
+  expect(result.stdout).toEndWith("\n");
+  return { ...result, response: JSON.parse(result.stdout) };
+}
+
+test("recovery is discoverable without changing existing capabilities", async () => {
+  for (const args of [["--help"], ["presentation", "--help"]]) {
+    const help = await cli(args);
+    expect(help.code).toBe(0);
+    expect(help.stdout).toContain(
+      "hamio presentation recover --input RECORDING --output RECORDING",
+    );
+  }
+  const result = await cli(["presentation", "capabilities"]);
+  expect(result.code).toBe(0);
+  expect(JSON.parse(result.stdout)).toMatchObject({
+    protocolVersion: 2,
+    modes: ["static", "live"],
+    renderer: "terminal",
+    recordingVersion: 1,
+    recording: { live: true, report: "html", recover: true, limits: recordingLimits },
+  });
+});
+
+test.each([
+  [],
+  ["--input"],
+  ["--output"],
+  ["--input", "x"],
+  ["--output", "y"],
+  ["--input", "-", "--output", "y"],
+  ["--input", "x", "--output", "-"],
+  ["--input", "x", "--output"],
+  ["--input", "--output", "y"],
+  ["--input", "x", "--output", "y", "--input", "x"],
+  ["--input", "x", "--output", "y", "--output", "z"],
+  ["--input", "x", "--output", "y", "--unknown"],
+  ["--input", "x", "--output", "y", "extra"],
+  ["--input", "x", "--output", "y", "--no-color"],
+  ["--input", "", "--output", "y"],
+  ["--input=x", "--output=y"],
+])("recovery rejects invalid arguments %j", async (...args) => {
+  const result = await cli(["presentation", "recover", ...args]);
+  expect(result.code).toBe(2);
+  expect(result.stderr).toBe("");
+  expect(JSON.parse(result.stdout)).toMatchObject({
+    protocolVersion: 2,
+    status: "error",
+    error: { code: "INVALID_ARGUMENT" },
+  });
+});
+
+test.each([
+  ["header only", headerLine, "partial", 0, null],
+  ["empty partial", `${headerLine}${trailerLine("partial", 0, null)}`, "partial", 0, null],
+  ["running prefix", prefix, "partial", 1, "running"],
+  ["final event without LF", `${prefix}${finish}`, "partial", 1, "running"],
+  ["broken final fragment", `${prefix}{${rejected}`, "partial", 1, "running"],
+  [
+    "invalid UTF-8 fragment",
+    Buffer.concat([Buffer.from(prefix), Buffer.from([0xff])]),
+    "partial",
