diff --git a/src/application/presentation-recover.ts b/src/application/presentation-recover.ts
new file mode 100644
index 0000000..140701e
--- /dev/null
+++ b/src/application/presentation-recover.ts
@@ -0,0 +1,50 @@
+import { randomUUID } from "node:crypto";
+import { link, open, unlink } from "node:fs/promises";
+import { dirname, join } from "node:path";
+import { Cancelled, RecordingRecoveryError } from "./error.ts";
+import { readRecording } from "../recording/reader.ts";
+import { RecordingWriteError, RecordingWriter } from "../recording/writer.ts";
+
+/** Only validated frames cross into the writer; publication never replaces a path. */
+export async function recoverRecording(input: string, output: string, signal: AbortSignal) {
+  const temporary = join(dirname(output), `.hamio-recover-${randomUUID()}.tmp`);
+  let ownsTemporary = false;
+  let writer: RecordingWriter | undefined;
+  try {
+    const replay = await readRecording(input, signal, {
+      async start() {
+        const file = await open(temporary, "wx", 0o600);
+        ownsTemporary = true;
+        writer = await RecordingWriter.fromFile(file, signal);
+      },
+      async append(event) {
+        if (!writer) throw new Error("Recording writer was not initialized.");
+        await writer.append(event);
+      },
+    });
+    if (!writer) {
+      if (replay.kind === "invalid")
+        throw new RecordingRecoveryError(replay.issue.code, 2, replay.issue.message);
+      throw new Error("Recording header was not accepted.");
+    }
+    const status = replay.kind === "complete" ? "complete" : "partial";
+    await writer.finish(status);
+    signal.throwIfAborted();
+    try {
+      await link(temporary, output);
+    } catch (error) {
+      if ((error as NodeJS.ErrnoException).code === "EEXIST")
+        throw new RecordingRecoveryError("INVALID_ARGUMENT", 2, "Output file already exists.");
+      throw error;
+    }
+    return { replay, status };
+  } catch (error) {
+    if (signal.aborted) throw new Cancelled();
+    if (error instanceof RecordingRecoveryError || error instanceof RecordingWriteError)
+      throw error;
+    throw new RecordingRecoveryError("IO_ERROR", 7, "Could not recover Recording file.");
+  } finally {
+    await writer?.abort();
+    if (ownsTemporary) await unlink(temporary).catch(() => {});
+  }
+}
