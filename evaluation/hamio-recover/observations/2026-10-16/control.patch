+        env: { PATH: "/nonexistent", HOME: directory },
+        stdin: "ignore",
+        stdout: "pipe",
+        stderr: "pipe",
+        timeout: 5000,
+      },
+    );
+    const [code, stdout, stderr] = await Promise.all([
